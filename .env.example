# Copiar únicamente valores de un proyecto NUEVO para El Viejo. Nunca subir .env.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Tres puertas independientes: ninguna integración real se activa por defecto.
BOT_ENABLED=false
WHATSAPP_SEND_ENABLED=false
AI_IMAGE_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
META_APP_SECRET=
WORKER_SECRET=
# API Responses de OpenAI o proveedor compatible; HTTPS obligatorio.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
# También se aceptan las variables OPENAI_API_KEY, OPENAI_MODEL,
# OPENAI_VISION_MODEL del upstream; no hacen falta si se usan AI_*.

# Opcional, solo después de preparar y auditar el bucket privado en Supabase aislado.
MENU_PHOTO_STORAGE_ENABLED=false
MENU_PHOTO_BUCKET=el-viejo-menu-private
# Vacío: sin vencimiento automático. Días >0: fecha de revisión de conservación.
# No borra automáticamente fotos de menús históricos.
MENU_PHOTO_RETENTION_DAYS=
# La prueba real MANUAL usa RUN_REAL_VISION_TEST, VISION_TEST_BASE_URL,
# VISION_TEST_ALLOWED_HOST y VISION_TEST_BEARER. Nunca configurarla en CI.

# PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_KEY: alcance Builds y también Functions
# para las validaciones de sesión y diagnóstico. Ambos URLs son del mismo proyecto.
# SUPABASE_SECRET_KEY (sb_secret_) y demás secretos: solo Functions.
# URL la inyecta Netlify en el despliegue publicado. No establecerla manualmente.
